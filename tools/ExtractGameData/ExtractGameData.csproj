<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Dalamud's own Lumina, so the sheet schema matches the installed game's data version. -->
  <PropertyGroup>
    <DalamudHooksDir>$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudHooksDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lumina">
      <HintPath>$(DalamudHooksDir)\Lumina.dll</HintPath>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudHooksDir)\Lumina.Excel.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
